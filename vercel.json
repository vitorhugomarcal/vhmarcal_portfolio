{
  "redirects": [
    {
      "source": "/pt",
      "destination": "https://orbizy.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.orbizy.app"
        }
      ],
      "destination": "https://orbizy.app/:path*",
      "permanent": true
    }
  ]
}
